#!/usr/bin/env python3
"""
Nyverune Theming Engine (Powered by Pywal)
Dynamic image-based & brand-fallback theming with Dark / Light mode and GTK integration.
https://github.com/nyverune/brand
"""

import os
import sys
import json
import shutil
import argparse
import subprocess
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
DOTFILES_DIR = SCRIPT_DIR.parent
WAL_THEMES_SRC = DOTFILES_DIR / "themes" / "wal" / "colorschemes"
WAL_CONFIG_DIR = Path.home() / ".config" / "wal"
CACHE_DIR = Path.home() / ".cache" / "wal"
STATE_FILE = Path.home() / ".cache" / "nyverune" / "state.json"

def sync_wal_themes():
    """Ensure Nyverune brand colorschemes are linked in ~/.config/wal/colorschemes/"""
    for bri in ("dark", "light"):
        src = WAL_THEMES_SRC / bri / "nyverune.json"
        dest_dir = WAL_CONFIG_DIR / "colorschemes" / bri
        dest = dest_dir / "nyverune.json"
        if src.is_file():
            try:
                dest_dir.mkdir(parents=True, exist_ok=True)
                if dest.is_symlink() or dest.exists():
                    dest.unlink()
                dest.symlink_to(src)
            except Exception:
                pass

# ------------------------------------------------------------------------------
# 1. State Management
# ------------------------------------------------------------------------------
def load_state() -> dict:
    if STATE_FILE.is_file():
        try:
            with open(STATE_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {"mode": "dark", "image": None, "source": "nyverune"}

def save_state(state: dict):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

# ------------------------------------------------------------------------------
# 2. GTK 3 & GTK 4 Configuration Writer
# ------------------------------------------------------------------------------
def apply_gtk_theme(mode: str, colors: dict):
    is_dark = (mode == "dark")
    prefer_dark_val = "1" if is_dark else "0"
    theme_name = "Adwaita-dark" if is_dark else "Adwaita"
    color_scheme = "prefer-dark" if is_dark else "prefer-light"

    special = colors.get("special", {})
    palette = colors.get("colors", {})

    bg = special.get("background", "#100D16" if is_dark else "#F7F4FA")
    fg = special.get("foreground", "#F6F0FC" if is_dark else "#181224")
    accent = palette.get("color5", palette.get("color13", "#A855F7" if is_dark else "#8B2CE2"))
    accent_fg = "#F6F0FC" if is_dark else "#FFFFFF"
    surface = palette.get("color0", "#181224" if is_dark else "#FFFFFF")
    border = palette.get("color8", "#2E2242" if is_dark else "#DED6EA")
    error = palette.get("color1", "#FF5C72" if is_dark else "#DC2626")
    success = palette.get("color2", "#75D6A3" if is_dark else "#059669")
    warning = palette.get("color3", "#FFC36B" if is_dark else "#D97706")

    # 1. Update settings.ini for GTK 3 & GTK 4
    settings_content = f"""# Auto-generated by nyverune-theme (pywal)
[Settings]
gtk-theme-name = {theme_name}
gtk-application-prefer-dark-theme = {prefer_dark_val}
gtk-icon-theme-name = Adwaita
"""

    for gtk_ver in ("gtk-3.0", "gtk-4.0"):
        config_dir = Path.home() / ".config" / gtk_ver
        config_dir.mkdir(parents=True, exist_ok=True)
        with open(config_dir / "settings.ini", "w") as f:
            f.write(settings_content)

    # 2. Update gtk.css with Libadwaita / GTK named color overrides
    gtk_css = f"""/* Auto-generated by nyverune-theme via pywal */
@define-color accent_color {accent};
@define-color accent_bg_color {accent};
@define-color accent_fg_color {accent_fg};

@define-color destructive_color {error};
@define-color destructive_bg_color {error};
@define-color destructive_fg_color #FFFFFF;

@define-color success_color {success};
@define-color success_bg_color {success};
@define-color success_fg_color {'#100D16' if is_dark else '#FFFFFF'};

@define-color warning_color {warning};
@define-color warning_bg_color {warning};
@define-color warning_fg_color {'#100D16' if is_dark else '#FFFFFF'};

@define-color error_color {error};
@define-color error_bg_color {error};
@define-color error_fg_color #FFFFFF;

@define-color window_bg_color {bg};
@define-color window_fg_color {fg};

@define-color view_bg_color {surface};
@define-color view_fg_color {fg};

@define-color headerbar_bg_color {surface};
@define-color headerbar_fg_color {fg};
@define-color headerbar_border_color {border};

@define-color card_bg_color {surface};
@define-color card_fg_color {fg};
@define-color card_border_color {border};

@define-color popover_bg_color {surface};
@define-color popover_fg_color {fg};

@define-color dialog_bg_color {surface};
@define-color dialog_fg_color {fg};
"""

    for gtk_ver in ("gtk-3.0", "gtk-4.0"):
        config_dir = Path.home() / ".config" / gtk_ver
        with open(config_dir / "gtk.css", "w") as f:
            f.write(gtk_css)

    # 3. Synchronize GSettings if available in active session
    try:
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", color_scheme],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", theme_name],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    except Exception:
        pass

# ------------------------------------------------------------------------------
# 3. Export Zsh Prompt Colors from Pywal Cache
# ------------------------------------------------------------------------------
def export_zsh_colors(mode: str, colors: dict):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    special = colors.get("special", {})
    palette = colors.get("colors", {})

    pri = palette.get("color5", "#A855F7")
    sec = palette.get("color13", palette.get("color6", "#FF5CB8"))
    acc = palette.get("color6", palette.get("color14", "#C084FC"))
    mut = palette.get("color8", "#8B8297")
    inf = palette.get("color4", palette.get("color12", "#72B7FF"))
    suc = palette.get("color2", palette.get("color10", "#75D6A3"))
    war = palette.get("color3", palette.get("color11", "#FFC36B"))
    err = palette.get("color1", palette.get("color9", "#FF5C72"))
    fg = special.get("foreground", "#F6F0FC")
    bg = special.get("background", "#100D16")
    bor = palette.get("color8", "#2E2242")

    zsh_lines = [
        f"# Dynamic Pywal Prompt Colors ({mode})",
        f'_NY_PRIMARY="%F{{{pri}}}"',
        f'_NY_SECONDARY="%F{{{sec}}}"',
        f'_NY_ACCENT="%F{{{acc}}}"',
        f'_NY_MUTED="%F{{{mut}}}"',
        f'_NY_INFO="%F{{{inf}}}"',
        f'_NY_SUCCESS="%F{{{suc}}}"',
        f'_NY_WARNING="%F{{{war}}}"',
        f'_NY_ERROR="%F{{{err}}}"',
        f'_NY_FG="%F{{{fg}}}"',
        f'_NY_SURFACE="%K{{{bg}}}"',
        f'_NY_SURFACE_FG="%F{{{bg}}}"',
        f'_NY_BORDER="%F{{{bor}}}"',
    ]

    with open(CACHE_DIR / "colors.zsh", "w") as f:
        f.write("\n".join(zsh_lines) + "\n")

# ------------------------------------------------------------------------------
# 4. Core Theming Engine (Invoking Pywal)
# ------------------------------------------------------------------------------
def apply_theme(mode: str = None, image_path: str = None, force_nyverune: bool = False):
    state = load_state()

    target_mode = mode if mode in ("dark", "light") else state.get("mode", "dark")
    target_image = image_path if image_path is not None else state.get("image")

    # Ensure system wal is present
    wal_bin = shutil.which("wal") or "/usr/bin/wal"
    if not Path(wal_bin).is_file():
        print("\033[31mError:\033[0m pywal ('wal') is not installed or not in PATH.")
        sys.exit(1)

    # Sync Nyverune brand colorschemes to ~/.config/wal/colorschemes/
    sync_wal_themes()

    if force_nyverune or not target_image:
        target_image = None
        cmd = [str(wal_bin), "--theme", "nyverune", "-n", "-s", "-t"]
        if target_mode == "light":
            cmd.append("-l")
        source_desc = f"Nyverune Brand Palette ({target_mode.capitalize()})"
    else:
        img_p = Path(target_image).expanduser()
        if img_p.is_file():
            cmd = [str(wal_bin), "-i", str(img_p.resolve()), "-n", "-s", "-t"]
            if target_mode == "light":
                cmd.append("-l")
            source_desc = f"Pywal extraction from {img_p.name}"
        else:
            print(f"\033[33mWarning:\033[0m Image '{target_image}' not found. Falling back to Nyverune Brand Palette.")
            target_image = None
            cmd = [str(wal_bin), "--theme", "nyverune", "-n", "-s", "-t"]
            if target_mode == "light":
                cmd.append("-l")
            source_desc = f"Nyverune Brand Palette (Fallback)"

    # Run pywal
    result = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0 and result.stderr:
        print(f"\033[31mPywal Warning:\033[0m {result.stderr.strip()}")

    # Read generated colors from pywal's ~/.cache/wal/colors.json
    colors_json_path = CACHE_DIR / "colors.json"
    colors_data = {}
    if colors_json_path.is_file():
        try:
            with open(colors_json_path, "r") as f:
                colors_data = json.load(f)
        except Exception:
            pass

    # Apply to GTK and Zsh
    apply_gtk_theme(target_mode, colors_data)
    export_zsh_colors(target_mode, colors_data)

    # Save state
    new_state = {
        "mode": target_mode,
        "image": str(target_image) if target_image else None,
        "source": source_desc,
    }
    save_state(new_state)

    # Display status
    gtk_badge = f"\033[1;32m{'Adwaita-dark (Dark)' if target_mode == 'dark' else 'Adwaita (Light)'}\033[0m"
    mode_badge = f"\033[1;35m{target_mode.upper()}\033[0m"
    print(f"\033[1;38;2;168;85;247m Nyverune Theming Engine (Pywal)\033[0m")
    print(f"  Mode   : {mode_badge}")
    print(f"  Source : \033[36m{source_desc}\033[0m")
    print(f"  GTK    : {gtk_badge} (settings.ini & gtk.css updated)")
    if colors_data:
        pri = colors_data.get("colors", {}).get("color5", "N/A")
        bg = colors_data.get("special", {}).get("background", "N/A")
        print(f"  Colors : Primary={pri} | Background={bg}")

# ------------------------------------------------------------------------------
# 5. CLI Interface
# ------------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        description="Nyverune Theme Switcher using Pywal",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  nyverune-theme --dark                  # Apply Nyverune Dark theme & set GTK to dark
  nyverune-theme --light                 # Apply Nyverune Light theme & set GTK to light
  nyverune-theme --toggle                # Toggle between Dark and Light mode
  nyverune-theme --image wallpaper.png   # Extract palette with Pywal (skip wallpaper)
  nyverune-theme --image wallpaper.png --light
  nyverune-theme --reset                 # Reset to official Nyverune brand fallback
  nyverune-theme --status                # Show current active theme status
"""
    )
    parser.add_argument("action", nargs="?", choices=["dark", "light", "toggle", "status", "reset"],
                        help="Quick action: dark, light, toggle, status, reset")
    parser.add_argument("-d", "--dark", action="store_true", help="Set dark mode")
    parser.add_argument("-l", "--light", action="store_true", help="Set light mode")
    parser.add_argument("-t", "--toggle", action="store_true", help="Toggle between dark and light mode")
    parser.add_argument("-i", "--image", type=str, help="Path to image for pywal dynamic color extraction")
    parser.add_argument("-r", "--reset", action="store_true", help="Reset to official Nyverune brand fallback")
    parser.add_argument("-s", "--status", action="store_true", help="Display current theme status")

    args = parser.parse_args()

    if args.action == "dark":
        args.dark = True
    elif args.action == "light":
        args.light = True
    elif args.action == "toggle":
        args.toggle = True
    elif args.action == "status":
        args.status = True
    elif args.action == "reset":
        args.reset = True

    if args.status:
        state = load_state()
        print(f"\033[1;35mCurrent Theme Status (Pywal):\033[0m")
        print(f"  Mode    : {state.get('mode', 'dark')}")
        print(f"  Source  : {state.get('source', 'Nyverune Brand Palette')}")
        print(f"  Image   : {state.get('image', 'None')}")
        return

    mode = None
    if args.toggle:
        curr = load_state().get("mode", "dark")
        mode = "light" if curr == "dark" else "dark"
    elif args.light:
        mode = "light"
    elif args.dark:
        mode = "dark"

    apply_theme(mode=mode, image_path=args.image, force_nyverune=args.reset)

if __name__ == "__main__":
    main()
