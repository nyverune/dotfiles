{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "magenta",
      "2": "cyan"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "magenta",
      "title": "magenta"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󱎫 Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "yellow"
    },
    {
      "type": "swap",
      "key": "󰯍 Swap (ZRAM+SSD)",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk (/)",
      "keyColor": "blue"
    },
    {
      "type": "battery",
      "key": "󰁹 Battery",
      "keyColor": "cyan"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
