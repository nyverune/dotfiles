# ==============================================================================
# Nyverune Mako Notification Configuration
# Modern, sleek aesthetic with JetBrainsMono Nerd Font & Pywal dynamic theme
# ==============================================================================

# Global Geometry & Layout
font=JetBrainsMono Nerd Font 10
width=380
height=160
margin=12
padding=14,18
border-size=2
border-radius=12
icons=1
max-icon-size=48
icon-border-radius=8
anchor=top-right
layer=overlay
default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time
format=<b>%s</b>\n%b

# Fallback Colors (Nyverune Purple Aesthetic)
background-color=#100D16FA
text-color=#F6F0FC
border-color=#A855F7
progress-color=over #A855F7

# Dynamic Pywal Colors & Urgency Criteria (Must be in global section)
include=/home/nyverune/.cache/wal/colors-mako
