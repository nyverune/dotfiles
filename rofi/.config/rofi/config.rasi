/**
 * Nyverune Application Launcher - Modern Dynamic Rofi Theme
 * https://github.com/nyverune/brand
 **/

configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        " ";
    display-window:             " ";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    font:                       "JetBrainsMono Nerd Font 11";
}

@import "~/.cache/wal/colors-rofi.rasi"

* {
    border-radius:              12px;
    background-color:           transparent;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      640px;
    x-offset:                   0px;
    y-offset:                   0px;
    enabled:                    true;
    margin:                     0px;
    padding:                    24px;
    border:                     2px;
    border-radius:              18px;
    border-color:               @wal-primary;
    background-color:           @wal-bg;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    16px;
    margin:                     0px;
    padding:                    0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    10px 14px;
    border:                     1px;
    border-radius:              12px;
    border-color:               @wal-border;
    background-color:           @wal-bg-alt;
    text-color:                 @wal-fg;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 @wal-primary;
}

entry {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 inherit;
    cursor:                     text;
    placeholder:                "Search applications...";
    placeholder-color:          @wal-muted;
}

listview {
    enabled:                    true;
    border:                     0px;
    border-color:               transparent;
    columns:                    1;
    lines:                      7;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    6px;
    margin:                     0px;
    padding:                    0px;
    background-color:           transparent;
    text-color:                 @wal-fg;
    cursor:                     "default";
}

element {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    10px 14px;
    border-radius:              10px;
    background-color:           transparent;
    text-color:                 @wal-fg;
    cursor:                     pointer;
    children:                   [ "element-icon", "element-text" ];
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @wal-fg;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @wal-fg;
}

element normal.urgent {
    background-color:           @wal-urgent;
    text-color:                 @wal-fg;
}

element alternate.urgent {
    background-color:           @wal-urgent;
    text-color:                 @wal-fg;
}

element normal.active {
    background-color:           @wal-active;
    text-color:                 @wal-fg;
}

element alternate.active {
    background-color:           @wal-active;
    text-color:                 @wal-fg;
}

element selected.normal {
    background-color:           @wal-bg-alt;
    border:                     1px;
    border-radius:              10px;
    border-color:               @wal-primary;
    text-color:                 @wal-primary;
}

element selected.urgent {
    background-color:           @wal-urgent;
    text-color:                 #FFFFFF;
}

element selected.active {
    background-color:           @wal-primary;
    text-color:                 #FFFFFF;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}
